{
  "name": "local-flow",
  "version": "0.8.14",
  "private": true,
  "description": "Aplicativo local de ditado e transcrição para Windows",
  "author": "Thiago Marçal",
  "type": "module",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:share": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-share-package.ps1",
    "dist:msix:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-msix-dev.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "icon": "electron scripts/make-icon.cjs",
    "electron:install": "node node_modules/electron/install.js",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:core": "node scripts/test-core.mjs",
    "smoke": "node scripts/electron-smoke.mjs",
    "smoke:packaged": "node scripts/electron-packaged-smoke.mjs",
    "test:e2e": "node scripts/electron-e2e.mjs",
    "test:mic": "node scripts/electron-mic-test.mjs",
    "test:tray": "node scripts/electron-tray-test.mjs",
    "test:lifecycle": "node scripts/electron-lifecycle-test.mjs",
    "test:shortcut": "node scripts/electron-shortcut-test.mjs",
    "test:insertion": "node scripts/electron-insertion-test.mjs",
    "test:settings": "node scripts/electron-settings-test.mjs",
    "test:single-instance": "node scripts/electron-single-instance-test.mjs",
    "test:revision": "node scripts/electron-revision-test.mjs",
    "test:revision:real": "node scripts/electron-revision-real-test.mjs",
    "test:personalization": "node scripts/electron-personalization-test.mjs",
    "test:setup": "node scripts/electron-setup-test.mjs",
    "test:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-test.ps1",
    "metrics": "node scripts/electron-metrics.mjs",
    "capture:ui": "node scripts/capture-ui.mjs",
    "capture:capsule": "node scripts/capture-capsule.mjs",
    "record:samples": "node scripts/record-samples.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:revision": "node scripts/benchmark-revision.mjs",
    "benchmark:light": "node scripts/benchmark-light-cleanup.mjs",
    "benchmark:personalization": "node scripts/benchmark-personalization.mjs",
    "phase1:check": "node scripts/check-phase1.mjs",
    "phase2:check": "node scripts/check-phase2.mjs",
    "phase3:check": "node scripts/check-phase3.mjs",
    "phase4:check": "node scripts/check-phase4.mjs",
    "phase5:check": "node scripts/check-phase5.mjs",
    "phase6:check": "node scripts/check-phase6.mjs",
    "phase7:check": "node scripts/check-phase7.mjs",
    "phase8:check": "node scripts/check-phase8.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@microsoft/winappcli": "^0.5.0",
    "electron": "42.5.0",
    "electron-builder": "^26.15.3"
  }
}
